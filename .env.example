# Copy to `.env` in the repo root. Docker Compose loads it automatically.
# Never commit `.env`. All values below are local-dev placeholders.

# -----------------------------------------------------------------------------
# LiveKit (voice / camera / screenshare). The Hono API mints participant JWTs
# with these keys; this stack only runs the SFU.
# LIVEKIT_API_SECRET must be >= 32 characters (LiveKit production requirement).
# Do not put a colon (`:`) inside the secret — LIVEKIT_KEYS is parsed as "key: secret".
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=coliseum-dev-livekit-secret-change-me
# Public URL browsers and the LiveKit JS SDK use (scheme ws/wss).
LIVEKIT_URL=ws://localhost:7880
# HTTP API the Hono backend calls (RoomService / token validation helpers).
LIVEKIT_HTTP_URL=http://localhost:7880

# Advertised ICE/WebRTC IP. Leave empty for auto-detect inside Docker.
# - Browser on the same machine: 127.0.0.1
# - Phones on the same Wi-Fi: your LAN IP (e.g. 192.168.1.10)
# - Cloud VM with public IP: set use_external_ip in infra/livekit/livekit.yaml
# LIVEKIT_NODE_IP=127.0.0.1

# -----------------------------------------------------------------------------
# Valkey (RESP) — LiveKit coordination (DB 1 in infra/livekit/livekit.yaml).
# The Hono API currently uses SQLite (apps/api). DB 0 is reserved if the API
# later adds pub/sub; it does not need Valkey to start. URL scheme stays redis://.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# OvenMediaEngine (optional — only used with `--profile ome`)
# Change OME_API_ACCESS_TOKEN in BOTH `.env` and infra/ome/origin_conf/Server.xml
# (XML cannot read Compose env unless you edit the file).
# -----------------------------------------------------------------------------
OME_HOST_IP=127.0.0.1
OME_VHOST=default
OME_APP=app
OME_API_ACCESS_TOKEN=coliseum-dev-ome-token-change-me
OME_API_URL=http://localhost:8081
OME_RTMP_INGEST_URL=rtmp://localhost:1935/app
OME_WEBRTC_PLAYBACK_BASE=ws://localhost:3333/app
OME_LLHLS_PLAYBACK_BASE=http://localhost:3333/app
# Aliases consumed by apps/api (same values):
OME_RTMP_URL=rtmp://localhost:1935/app
OME_PLAYBACK_URL=ws://localhost:3333/app

# Stream key == Amphitheatre room id (same string LiveKit uses as room name).
# OBS: Server rtmp://HOST:1935/app   Stream key: {roomId}
# Play WebRTC: ws://HOST:3333/app/{roomId}
# Play LLHLS:  http://HOST:3333/app/{roomId}/llhls.m3u8

# -----------------------------------------------------------------------------
# Hono API (:3001) + Vite SPA (:5173) are NOT started by this compose.
# They read the LIVEKIT_* / OME_* keys above from the repo-root .env (or apps/api/.env).
# Admission/LiveKit webhooks stay commented in Server.xml / livekit.yaml until enabled.
# -----------------------------------------------------------------------------
API_PORT=3001
WEB_PORT=5173
# From inside Docker (Linux needs extra_hosts host.docker.internal:host-gateway,
# already set on livekit/ome):
OME_ADMISSION_WEBHOOK_URL=http://host.docker.internal:3001/webhooks/ome/admission
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:3001/webhooks/livekit

# Production hostnames (Caddy profile). Leave as-is for local.
COLISEUM_DOMAIN=localhost
COLISEUM_LIVEKIT_HOST=livekit.localhost
COLISEUM_STREAM_HOST=stream.localhost
COLISEUM_API_HOST=api.localhost
COLISEUM_APP_HOST=app.localhost

# -----------------------------------------------------------------------------
# Hono API (apps/api) — nao e iniciado pelo Compose
# -----------------------------------------------------------------------------
SESSION_SECRET=coliseum-dev-session-secret-change-me
DATABASE_PATH=./apps/api/data/coliseum.sqlite
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Aliases aceitos pela API (contrato do backend):
# OME_RTMP_URL=${OME_RTMP_INGEST_URL}
# OME_PLAYBACK_URL=${OME_WEBRTC_PLAYBACK_BASE}
