# Settings for your self-hosted Amphitheatre. Copy this file to ".env" in the
# same folder and fill in your own values. Full guide: docs/self-hosting.md
# (or https://github.com/simstm/amphitheatre/blob/main/docs/self-hosting.md).

# ---------------------------------------------------------------------------
# 1. Your domains
# ---------------------------------------------------------------------------
# Amphitheatre uses up to three subdomains. You only need the first one to
# get chat, voice, camera, and screen share working. The other two only
# matter if you turn on the optional live-broadcast stage.
#
#   PUBLIC_APP_HOSTNAME     -> where people open the app, e.g. amp.example.com
#   PUBLIC_LIVEKIT_HOSTNAME -> voice/video engine, e.g. live.example.com
#   PUBLIC_OME_HOSTNAME     -> optional broadcast engine, e.g. stream.example.com
#
# Point all three at your server's IP with DNS "A" records before continuing.

PUBLIC_APP_HOSTNAME=amp.example.com
PUBLIC_LIVEKIT_HOSTNAME=live.example.com
PUBLIC_OME_HOSTNAME=stream.example.com

# E-mail used by the reverse proxy (Caddy or Traefik) to request free TLS
# certificates from Let's Encrypt.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# 2. Secrets — replace every value below. Do not reuse the examples.
# ---------------------------------------------------------------------------
# Random string used to sign guest login cookies. Any long random text works,
# e.g. generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Credentials for the voice/video engine (LiveKit). LIVEKIT_API_SECRET must be
# at least 32 characters and must NOT contain ":". Generate with:
# openssl rand -hex 32
LIVEKIT_API_KEY=amphitheatre
LIVEKIT_API_SECRET=change-me-to-a-random-string-at-least-32-characters-long

# ---------------------------------------------------------------------------
# 3. Optional: broadcast stage (OBS -> everyone watches the same live stream)
# ---------------------------------------------------------------------------
# Only used if you start the "ome" profile. Must match
# deploy/ome/Server.xml's <AccessToken>.
OME_API_ACCESS_TOKEN=change-me
