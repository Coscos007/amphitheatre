# Copie para `.env` neste diretorio (apps/api) ou use o `.env` da raiz do monorepo.
# Valores abaixo sao placeholders de desenvolvimento local. Nao commite segredos reais.

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------
API_PORT=3001
# Origens da SPA Vite (separadas por virgula). Necessario para cookies.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Segredo HMAC do JWT de sessao (minimo 32 caracteres em producao).
SESSION_SECRET=coliseum-dev-session-secret-change-me
# SQLite: papeis, bans e lockouts sobrevivem a restart do processo.
DATABASE_PATH=./data/coliseum.sqlite
# Confiar em X-Forwarded-For (so atras de proxy conhecido).
TRUST_PROXY=false
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# LiveKit (voz / camera / screenshare). Nomes alinhados ao .env.example da raiz.
# -----------------------------------------------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=coliseum-dev-livekit-secret-change-me
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880

# -----------------------------------------------------------------------------
# OvenMediaEngine (opcional). A API sobe sem OME.
# Aceita OME_RTMP_URL / OME_PLAYBACK_URL (contrato) e os aliases da infra:
# OME_RTMP_INGEST_URL / OME_WEBRTC_PLAYBACK_BASE.
# -----------------------------------------------------------------------------
OME_API_URL=http://localhost:8081
OME_API_ACCESS_TOKEN=coliseum-dev-ome-token-change-me
OME_VHOST=default
OME_APP=app
OME_RTMP_URL=rtmp://localhost:1935/app
OME_PLAYBACK_URL=ws://localhost:3333/app
OME_LLHLS_PLAYBACK_BASE=http://localhost:3333/app
OME_TIMEOUT_MS=1000

# -----------------------------------------------------------------------------
# Limites (abuso / capacidade)
# -----------------------------------------------------------------------------
MAX_ROOMS_PER_CREATOR=10
MAX_ROOMS_PER_IP=20
MAX_MEMBERS_PER_ROOM=50
MAX_CONCURRENT_ROOMS=200
ROOM_CREATE_WINDOW_HOURS=24
LOCKOUT_MAX_FAILURES=3
LOCKOUT_DURATION_MS=300000
CHAT_HISTORY_LIMIT=200
WS_GRACE_MS=15000
